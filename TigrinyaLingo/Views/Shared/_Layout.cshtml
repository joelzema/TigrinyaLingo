<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TigrinyaLingo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TigrinyaLingo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/culture.css" asp-append-version="true" />
@await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/ui-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="culture-backdrop" aria-hidden="true"></div>
    <header class="culture-header">
        <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand culture-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/jebena.svg" asp-append-version="true" width="26" height="32" alt="" aria-hidden="true" />
                    <span>TigrinyaLingo</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Öppna menyn">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarSupportedContent" class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Courses" asp-action="Index">Kurser</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link learning-nav-primary" asp-area="" asp-controller="Learn" asp-action="Index">Fortsätt lära</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Games" asp-action="Index">Träna</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer culture-footer text-muted">
        <div class="container">
            &copy; 2026 - TigrinyaLingo
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
